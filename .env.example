GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Add these only when connecting a live GitHub repository in file 04.
# GITHUB_REPOSITORY has a committed team default (see deliverables/DECISIONS.md
# and deliverables/ACCESS_MATRIX.md) — leave blank unless overriding it locally.
GITHUB_REPOSITORY=
# Optional: raises the unauthenticated GitHub API cap (60 requests/hour,
# shared by everyone on the same network) to 5000/hour. A fine-grained
# personal access token scoped to Issues: Read-only on the one repo above
# is enough — see deliverables/PROGRESS_LOG.md's Phase 8 section for setup
# steps. Phase 8's automated evaluation run exhausted the unauthenticated
# limit; every case is documented in EVALUATION_REPORT.md either way.
GITHUB_TOKEN=
