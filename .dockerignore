# Generated/runtime data (persists via the docker-compose ./data bind mount
# instead; see deliverables/DECISIONS.md "Phase 9: Container packaging").
# data/raw/ and data/database/company.db are NOT excluded -- they ship in
# the image as the self-contained fixture/fallback.
data/index/
data/generated/
data/database/app_state.db
data/database/*.db-journal
data/database/*.db-shm
data/database/*.db-wal

